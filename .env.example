# PostgreSQL Database Configuration
DATABASE_URL=postgresql://waterwatch_user:waterwatch_password@localhost:5432/waterwatch_db

# Google Maps API Key (Required for Route Recommendation)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Weather API (e.g. OpenWeatherMap as fallback)
# WEATHER_API_KEY=your_weather_api_key_here

# API Secret Key for JWT Authentication (Backend)
SECRET_KEY=generate_a_secure_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
